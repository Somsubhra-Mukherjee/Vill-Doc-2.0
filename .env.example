# VillDoc 2.0 Environment Configuration
# Provide your official Sarvam API key here
SARVAM_API_KEY=your_actual_key_here

# Optional configuration
# Model choices: sarvam-105b-conversations (recommended) or sarvam-105b
SARVAM_CHAT_MODEL=sarvam-105b-conversations

# STT model: saaras:v4 (recommended) or saaras:v3
SARVAM_STT_MODEL=saaras:v4

# TTS model: bulbul:v4-flash (recommended) or bulbul:v3
SARVAM_TTS_MODEL=bulbul:v4-flash

# Default speaker voice persona (e.g. shubh, shubh_enhi_ads, aditya, ritu)
SARVAM_TTS_SPEAKER=shubh

# Environment & Server settings
PORT=8000
HOST=0.0.0.0
DEBUG=false
